# ============================================
# Vibe Kanban Environment Configuration
# ============================================
# 
# 本文件是环境变量配置模板
# 复制此文件为 .env 并填入实际值
# 
# 重要：永远不要提交包含真实密钥的 .env 文件到版本控制！
# ============================================

# --------------------------------------------
# 开发环境配置
# --------------------------------------------

# 前端服务端口
FRONTEND_PORT=23001

# 后端服务端口
BACKEND_PORT=23002

# 服务监听地址
HOST=0.0.0.0

# 后端 API URL（可选，前端会自动检测）
# VITE_BACKEND_API_URL=http://localhost:23002

# --------------------------------------------
# OAuth / Casdoor 配置
# --------------------------------------------

# OAuth 回调 URL（生产环境使用实际域名）
OAUTH_CALLBACK_URL=https://your-domain.com/api/auth/handoff/complete

# Casdoor 服务器地址
CASDOOR_URL=https://auth.example.com

# Casdoor 应用客户端 ID
CASDOOR_CLIENT_ID=your_client_id_here

# Casdoor 应用客户端密钥（敏感信息）
CASDOOR_CLIENT_SECRET=your_client_secret_here

# JWKS (JSON Web Key Set) 端点
JWKS_ENDPOINT=https://auth.example.com/.well-known/jwks

# --------------------------------------------
# GOST 隧道配置
# --------------------------------------------

# GOST 可执行文件路径
GOST_BINARY_PATH=./bin/gost

# GOST 服务器地址和端口
GOST_SERVER_ADDR=127.0.0.1:19000

# 网关基础 URL（本地开发）
GATEWAY_BASE_URL=http://localhost:23001

# 网关 API URL（生产环境）
GATEWAY_API_URL=https://api.your-domain.com

# 网关 API 认证令牌（如果需要）
GATEWAY_API_TOKEN=

# --------------------------------------------
# 数据库配置（如果使用）
# --------------------------------------------

# DATABASE_URL=postgresql://user:password@localhost:5432/vibe_kanban

# --------------------------------------------
# 日志配置
# --------------------------------------------

# Rust 日志级别（debug, info, warn, error）
RUST_LOG=info

# --------------------------------------------
# 其他配置
# --------------------------------------------

# 禁用工作树孤儿清理（开发模式）
DISABLE_WORKTREE_ORPHAN_CLEANUP=1

# PostHog 分析（可选）
# VITE_PUBLIC_POSTHOG_KEY=your_posthog_key
# VITE_PUBLIC_POSTHOG_HOST=https://app.posthog.com
